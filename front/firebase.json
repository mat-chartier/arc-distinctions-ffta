{
  "hosting": [
    {
      "site": "arc-distinctions",
      "public": "dist/arc-distionctions-ffta/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "distinctarc",
      "public": "landing",
      "ignore": ["**/.*"],
      "cleanUrls": true
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
